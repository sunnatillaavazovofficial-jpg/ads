# ===== Asosiy =====
# Birinchi ishga tushganda yaratiladigan administrator (keyin saytdan parolni o'zgartiring)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Saytning tashqi manzili (bot xabarlaridagi "Saytda ochish" tugmasi uchun)
SITE_URL=https://crm.sizning-domen.uz

# Sessiya kaliti (bo'sh qolsa avtomatik yaratiladi). Uzun tasodifiy satr yozing.
SECRET_KEY=

# HTTPS orqali ishlasangiz true qiling
SECURE_COOKIES=false

# ===== Telegram bot (@BotFather dan) =====
BOT_TOKEN=

# ===== Telegram akkauntlarni ulash (https://my.telegram.org -> API development tools) =====
TG_API_ID=
TG_API_HASH=
# Saytda chat ochilganda Telegramda ham "o'qildi" belgisi qo'yilsinmi
TG_MARK_READ=true

# ===== Boshqa =====
MAX_UPLOAD_MB=300
TIMEZONE=Asia/Tashkent
# CURRENCY=so'm  (standart qiymat)
