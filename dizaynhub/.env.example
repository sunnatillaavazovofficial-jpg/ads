# ===== DizaynHub sozlamalari =====
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.

# Sayt nomi (menyuda ko'rinadi)
SITE_NAME=DizaynHub

# Server manzili. Cloudflare Tunnel ishlatsangiz 127.0.0.1 qoldiring.
# Lokal tarmoqdan (Wi-Fi) ham kirish kerak bo'lsa: 0.0.0.0
HOST=127.0.0.1
PORT=8000

# Saytning domen manzili (bot xabarlaridagi havolalar uchun)
PUBLIC_URL=https://ish.sizning-domen.uz
# Domen (HTTPS) ulangandan keyin true qiling
COOKIE_SECURE=false

# Ro'yxatdan o'tish kalitlari (bo'sh qoldirsangiz tasodifiy yaratiladi va
# data/KALITLAR.txt fayliga yoziladi). Keyinchalik admin panelidan o'zgartiriladi.
ADMIN_KEY=
MANAGER_KEY=
CHIEF_KEY=
DESIGNER_KEY=

# Telegram API (https://my.telegram.org/apps -> API development tools)
TG_API_ID=
TG_API_HASH=

# Telegram bot tokeni (@BotFather -> /newbot)
BOT_TOKEN=

# Telegramdan saytga yuklanadigan media hajmi chegarasi (MB)
TG_MEDIA_MAX_MB=50
