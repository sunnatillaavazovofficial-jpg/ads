# @BotFather bergan token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sizning Telegram ID raqamingiz (faqat shu odam botdan foydalana oladi)
OWNER_ID=123456789
# Birinchi ishga tushishda ruxsat beriladigan odamlar (vergul bilan, ixtiyoriy).
# Keyin ruxsatlar bot ichida boshqariladi: «➕ Odam qo'shish» / «👥 Foydalanuvchilar».
ALLOWED_IDS=

# Ixtiyoriy sozlamalar
# Xabarlar bazada necha kun saqlansin
KEEP_DAYS=30
# Vaqt zonasi (UTC+5 = Toshkent)
TZ_OFFSET=5
# Bir vaqtda shuncha xabar o'chirilsa — chat tozalandi deb hisoblanadi
CLEAR_MIN=5
# Saqlash uchun yozgan reply xabaringizni chatdan avtomatik o'chirish (1/0)
DELETE_TRIGGER_REPLY=1
# Baza fayli joylashuvi
# DB_PATH=data/messages.db
